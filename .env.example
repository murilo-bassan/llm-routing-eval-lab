# Offline arms need nothing. To add the LLM arm and the keywords→LLM cascade:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=            <- from your shell / CI secret, never committed
# LAB_LLM_MODEL=
# LAB_PRICE_IN=0          # USD per 1M input tokens, for the cost column
# LAB_PRICE_OUT=0
# LAB_CASCADE_TAU=0.75
